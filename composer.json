{
    "name": "wilycode/container",
    "description": "Lightweight PSR-11 dependency injection container with explicit factories and constructor autowiring.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\Container\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\Container\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/phpunit.xml.dist",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/CONTRIBUTING.md",
            "/CHANGELOG.md",
            "/composer.lock",
            "/.phpunit.cache",
            "/.phpunit.result.cache"
        ]
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "keywords": [
        "container",
        "dependency-injection",
        "psr-11",
        "autowiring",
        "php"
    ],
    "homepage": "https://github.com/wilycode/container",
    "support": {
        "issues": "https://github.com/wilycode/container/issues",
        "source": "https://github.com/wilycode/container"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    }
}
